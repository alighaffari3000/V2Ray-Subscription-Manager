# فایل سرویس systemd برای اجرای خودکار Flask
# مسیر: /etc/systemd/system/v2ray-sub.service

[Unit]
Description=V2Ray Subscription Management System
# Wants (not Requires): Redis backs the shared rate limiter but its absence
# must not block the panel from starting (falls back to per-worker memory://).
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/home/v2ray-sub
Environment="PATH=/home/v2ray-sub/venv/bin"
# --timeout kills a worker that hangs past 60s instead of leaving it stuck
# until a manual restart. --max-requests recycles each worker after ~500
# requests (jittered) so a slow per-request memory leak can't accumulate
# indefinitely.
ExecStart=/home/v2ray-sub/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5000 --timeout 60 --graceful-timeout 30 --max-requests 500 --max-requests-jitter 50 app:app

# امنیت
PrivateTmp=true
NoNewPrivileges=true

# ری‌استارت خودکار در صورت خطا
Restart=always
RestartSec=10

# محدودیت منابع: اسکن‌های discovery/health-check چند sing-box هم‌زمان اجرا
# می‌کنند؛ بدون سقف، مصرف رم می‌تواند کل VPS را OOM-kill کند. مقادیر برای
# سرور 2GB تنظیم شده‌اند تا جای کافی برای OS/nginx/redis بماند.
MemoryHigh=1200M
MemoryMax=1400M
CPUQuota=90%

# لاگ‌ها
StandardOutput=journal
StandardError=journal
SyslogIdentifier=v2ray-sub

[Install]
WantedBy=multi-user.target
